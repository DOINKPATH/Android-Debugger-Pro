#!/usr/bin/env bash
# adbw - wire up Android Debug Bridge to the phone, USB-first (wireless/kali aware).
# No KDE, no extra apps - pure adb/bash.
set -euo pipefail

# --- config (override via env) ---
PHONE_BT_ADDR="${PHONE_BT_ADDR:-BC:94:24:32:E8:43}"
ADB_PORT="${ADB_PORT:-5555}"
PHONE_NAME="${PHONE_NAME:-TCL 50 XL NXTPAPER 5G}"

say()  { printf '\033[1;34m[adbw]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[adbw]\033[0m %s\n' "$*"; }

# Start daemon (idempotent)
adb start-server >/dev/null 2>&1 || adb start-daemon >/dev/null 2>&1 || true

# 1) Any live adb device (USB or TCP — robust "<serial><TAB>device" check)?
if adb devices | awk 'NR>1 && $2=="device"{f=1} END{exit !f}'; then
    say "ADB device present:"
    adb devices -l
    say "Wireless ADB stay-on: 'adb tcpip $ADB_PORT'"
    exit 0
fi

# 2) Try device on the phone side: Bluetooth first, then plain Wi-Fi.
BT_OK=0
if command -v bluetoothctl >/dev/null; then
  bluetoothctl connect "$PHONE_BT_ADDR" >/dev/null 2>&1 && sleep 2
  bluetoothctl info "$PHONE_BT_ADDR" | grep -q "Connected: yes" && BT_OK=1
fi

try() { # try <label> <ip>
  if adb connect "$2:$ADB_PORT" 2>&1 | grep -qi 'connected'; then
    say "Connected to $1 ($2:$ADB_PORT)"
    adb devices -l
    return 0
  fi
  return 1
}

# Bluetooth tunnelled IP (assumes the host talking to phone over PANU gets a link-local)
if [ "$BT_OK" = 1 ]; then
  bt_ip="$(ip -o -4 addr show bnep0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"
  [ -n "${bt_ip:-}" ] && try "Bluetooth ($PHONE_NAME)" "$bt_ip" && exit 0
  # fall back to a common static used by adb-over-bluetooth setups
  try "Bluetooth (manual)" "169.254.0.1" && exit 0
fi

# Plain Wi-Fi on the phone (same LAN). Heuristic for phone's likely last address.
for host in \
  "$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')" \
  192.168.1.100 192.168.0.100 192.168.1.10 192.168.1.5
do
  [ -n "$host" ] && try "Wi-Fi $host" "$host" && exit 0
done

warn "No ADB target found over USB/Bluetooth/Wi-Fi."
warn "On the phone, enable Developer options -> ADB/Debug."
warn "Then either plug in USB, run 'adb tcpip $ADB_PORT', or set PHONE_IP and re-run."
exit 1