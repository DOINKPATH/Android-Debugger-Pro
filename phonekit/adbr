#!/usr/bin/env bash
# adbr - bind a local TCP port to Termux's sshd on the phone via `adb reverse`.
# This is the "both ways" ADB<->Termux bridge used by ssh2termux (and magctl).
#   usage: adbr [local_port] [termux_port]   defaults: 5022 -> 8022
set -euo pipefail

LOCAL="${1:-5022}"
TERMUX="${2:-8022}"

warn() { printf '\033[1;33m[adbr]\033[0m %s\n' "$*"; }

# Need a live adb device
if ! adb devices | awk 'NR>1 && $2=="device"{f=1} END{exit !f}'; then
  warn "No ADB device attached. Run ./adbw first."
  exit 1
fi

warn "Binding laptop 127.0.0.1:$LOCAL -> phone Termux sshd on :$TERMUX"
warn "Press Ctrl-C to stop the tunnel."
adb reverse "tcp:$LOCAL" "tcp:$TERMUX"